{% extends 'base.html' %}

{% block content %}
<div class="max-w-xl mx-auto mt-20 text-center bg-white p-8 rounded-lg shadow-md">
  <h2 class="text-3xl font-bold text-[#FF0B55]">Thank You for Your Feedback!</h2>

  <p class="mt-4 text-gray-700 text-lg">
    You reviewed <strong>{{ order.restaurant.name }}</strong> for Order ID: 
    <span class="font-semibold text-gray-800">#{{ order.id }}</span>.
  </p>

  <p class="mt-2 text-gray-600">We appreciate your input and hope to serve you again soon!</p>

  <a href="{% url 'home' %}" class="inline-block mt-6 px-5 py-2 bg-[#FF0B55] text-white rounded hover:bg-pink-600 transition duration-200">
    Back to Home
  </a>
</div>
{% endblock %}
